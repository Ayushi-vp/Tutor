# Copy to prep-console/.env and fill in. Never commit .env.

# Long random string that signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The public address people open, without a trailing slash. OAuth redirect URLs are built from it:
#   <BASE_URL>/auth/callback/google  and  <BASE_URL>/auth/callback/github
# Leave empty for local development (http://localhost:5000).
BASE_URL=

# Comma-separated. Admins can always sign in, manage invites and users, and the first
# admin to sign in takes over the progress saved before accounts existed.
ADMIN_EMAILS=

# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: github.com/settings/developers -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 1 = enable "sign in as any email" for local development. Only works for requests
# from this machine that did not come through a proxy. Keep it off on a shared host.
DEV_LOGIN=0

# 1 = trust X-Forwarded-* from one proxy hop (Tailscale Funnel, Caddy, nginx).
# Turned on automatically when BASE_URL starts with https://.
BEHIND_PROXY=0

# Optional
# PORT=5000
# PREP_DB=C:\path\to\prep.db
