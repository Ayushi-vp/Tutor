# Copy to prep-console/.env and fill in. Never commit .env.

# Long random string that signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The public address people open, without a trailing slash. OAuth redirect URLs are built from it:
#   <BASE_URL>/auth/callback/google  and  <BASE_URL>/auth/callback/github
# Leave empty for local development (http://localhost:5000).
BASE_URL=

# Comma-separated. Admins can always sign in, manage invites and users, and the first
# admin to sign in takes over the progress saved before accounts existed.
ADMIN_EMAILS=

# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: github.com/settings/developers -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 1 = enable "sign in as any email" for local development. Only works for requests
# from this machine that did not come through a proxy. Keep it off on a shared host.
DEV_LOGIN=0

# 1 = trust X-Forwarded-* from one proxy hop (Tailscale Funnel, Caddy, nginx).
# Turned on automatically when BASE_URL starts with https://.
BEHIND_PROXY=0

# The page tutor (highlight text or press Ctrl+K to ask about a topic). Works with any
# OpenAI-compatible chat API; stays switched off until LLM_BASE_URL and LLM_MODEL are set.
#   OpenAI       LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
#   OpenRouter   LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<provider>/<model>
#   Ollama       LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=llama3.1   (no key needed)
#   LM Studio    LLM_BASE_URL=http://localhost:1234/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Questions per member per day; admins are not limited. 0 = no limit.
CHAT_DAILY_LIMIT=50
# LLM_MAX_TOKENS=1200   # cap answer length; leave unset to use the server's default
# LLM_PROVIDER=fake     # canned answers, to try the UI without a model

# Optional
# HOST=127.0.0.1        # keep it on 127.0.0.1 unless a container or proxy needs 0.0.0.0
# PORT=5000
# PREP_DB=C:\path\to\prep.db
# BACKUP_DIR=C:\path\to\backups   # default: prep-console\backups
