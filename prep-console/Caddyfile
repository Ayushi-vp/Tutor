# Used by `docker compose --profile caddy up -d`. Caddy gets a TLS certificate for DOMAIN
# automatically; point the domain's DNS A record at the server first.
{$DOMAIN} {
	# Tutor answers stream as server-sent events; compressing them would hold each answer back.
	@compressible not path /api/chat
	encode @compressible gzip
	reverse_proxy app:5000
}
